{
  "manifest_version": 3,
  "name": "Atelier",
  "version": "0.4.0",
  "description": "Records and replays browser workflows that produce assets, driven by your coding agent.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "action": {
    "default_title": "Atelier"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "128": "src/icons/icon128.png"
  }
}
