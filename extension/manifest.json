{
  "manifest_version": 3,
  "name": "Atelier",
  "version": "0.5.2",
  "description": "Build a browser workflow step by step, then let your coding agent replay it.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Atelier",
    "default_popup": "src/panel/panel.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "128": "src/icons/icon128.png"
  }
}
