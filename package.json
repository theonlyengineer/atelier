{
  "name": "atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Local asset pipeline: an MCP server, a daemon, and a browser extension that record and replay browser workflows to produce assets.",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace server",
    "dev": "npm run dev --workspace server",
    "test": "npm run test --workspace server",
    "start": "node --disable-warning=ExperimentalWarning server/dist/daemon.js",
    "dashboard": "node -e \"console.log('http://127.0.0.1:' + (process.env.ATELIER_PORT || 7717))\""
  },
  "engines": {
    "node": ">=22"
  }
}
